# AI API 配置
REACT_APP_API_KEY=your_api_key_here
REACT_APP_BASE_URL=https://api.openai.com/v1
REACT_APP_MODEL=gpt-3.5-turbo

# 配置說明：
# REACT_APP_API_KEY: 您的AI API金鑰 (必填)
# REACT_APP_BASE_URL: API基礎URL (可選，默認為OpenAI)
# REACT_APP_MODEL: 使用的模型 (可選，默認為gpt-3.5-turbo)

# 使用說明：
# 1. 複製此檔案為 .env
# 2. 將 your_api_key_here 替換為您的實際 API Key
# 3. 根據需要調整 BASE_URL 和 MODEL
# 4. 如果沒有 API Key，遊戲會使用內建的備用AI邏輯

# 範例配置：
# OpenAI:
# REACT_APP_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# REACT_APP_BASE_URL=https://api.openai.com/v1
# REACT_APP_MODEL=gpt-3.5-turbo

# 其他相容API服務：
# REACT_APP_API_KEY=your_api_key_here
# REACT_APP_BASE_URL=https://your-api-endpoint.com/v1
# REACT_APP_MODEL=your-model-name
